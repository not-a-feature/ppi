{
  "name": "ppi-2",
  "version": "0.1.0",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:seed-playground": "tsx --env-file=.env scripts/seed-playground.ts",
    "db:bootstrap-admin": "tsx --env-file=.env scripts/bootstrap-admin.ts",
    "worker": "tsx --env-file=.env worker/index.ts"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "^0.7.2"
    }
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.50.0",
    "better-auth": "1.7.10",
    "nodemailer": "10.1.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.16.0",
    "pg-boss": "12.38.0",
    "svelte": "^5.0.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/yazl": "3.3.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "5.0.5"
  }
}
