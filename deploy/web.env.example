# Add these web-service settings to the deployment's database/auth/storage environment.
NODE_ENV=production
ADDRESS_HEADER=x-forwarded-for
PROTOCOL_HEADER=x-forwarded-proto
XFF_DEPTH=1
PORT=3000
BODY_SIZE_LIMIT=32M
# Host deployment: nginx runs on the same host and reaches this loopback listener.
HOST=127.0.0.1
# Container deployment: use HOST=0.0.0.0, a private nginx/web network, and no web ports mapping.
