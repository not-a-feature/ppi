DATABASE_URL=postgresql://ppi:ppi_local_only@127.0.0.1:54329/ppi
NODE_ENV=development
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:5173
ORIGIN=http://localhost:5173
# Direct development: do not trust client-supplied forwarded headers.
ADDRESS_HEADER=
XFF_DEPTH=1
BODY_SIZE_LIMIT=32M
UPLOAD_DIR=.data/files
SMTP_HOST=127.0.0.1
SMTP_PORT=10259
SMTP_FROM=PPI <ppi@localhost>
# Development only: technical checks without ClamAV. Production rejects this setting.
FILE_SCAN_MODE=development
ALLOW_DEMO_SEED=true
UPLOADS_PER_HOUR=30
UPLOAD_PENDING_LIMIT=10
UPLOAD_STORAGE_MIB=256
PDF_EXTRACT_TIMEOUT_MS=10000
